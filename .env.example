# 复制为 .env 后填写；应用启动读取 .env，进程环境变量优先。
DOCQA_DATA_DIR=./data
DOCQA_MAX_UPLOAD_MB=20

# 密钥仅存本地，勿提交到 Git 或填写到前端脚本。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=8192

# 用户指定的 Embedding 网关；必须使用该网关的独立密钥。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://tokendance.space/gateway/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=8

# ---------------------------------------------------------------------------
# Docling 解析服务（默认本机独立容器；地址只来自后端配置，前端不能覆盖）
# ---------------------------------------------------------------------------
DOCQA_DOCLING_BASE_URL=http://127.0.0.1:5001
# 连接超时、单次读取超时、整个任务等待期限分别配置，任何一项都不能为 0 或无限。
DOCQA_DOCLING_CONNECT_TIMEOUT_SECONDS=10
DOCQA_DOCLING_READ_TIMEOUT_SECONDS=120
DOCQA_DOCLING_TOTAL_TIMEOUT_SECONDS=1800
# 轮询间隔与“查询/领取结果”的有限重试；POST 提交不自动重试。
DOCQA_DOCLING_POLL_INTERVAL_SECONDS=2
DOCQA_DOCLING_MAX_RETRIES=3
DOCQA_DOCLING_RETRY_BACKOFF_SECONDS=2
# 解析参数：固定 RapidOCR + 中文 + accurate 表格；不默认启用远程 VLM、图片描述或公式增强。
DOCQA_DOCLING_OCR_ENGINE=rapidocr
DOCQA_DOCLING_OCR_LANG=ch
DOCQA_DOCLING_TABLE_MODE=accurate
DOCQA_DOCLING_IMAGE_EXPORT_MODE=placeholder
# 允许的 PDF 页数上限；不得超过解析服务自身配置的能力，超限返回明确失败。
DOCQA_MAX_PDF_PAGES=100

# ---------------------------------------------------------------------------
# 解析 worker（独立进程；Web 只创建任务与查询结果）
# ---------------------------------------------------------------------------
DOCQA_WORKER_LEASE_SECONDS=300
DOCQA_WORKER_IDLE_SLEEP_SECONDS=3

# ---------------------------------------------------------------------------
# 结构化分块（长度单位为字符，不是 token；上限需与 embedding 请求限制协调）
# ---------------------------------------------------------------------------
DOCQA_CHUNK_MAX_CHARS=800
DOCQA_CHUNK_OVERLAP_CHARS=120
DOCQA_TABLE_ROWS_PER_CHUNK=20
